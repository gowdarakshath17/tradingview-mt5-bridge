//+------------------------------------------------------------------+
//|                               TradingViewToMT5_Backtest.mq5      |
//|                               Generated by AI Studio             |
//|                                                                  |
//| This EA replicates your Pine Script logic for MT5 Strategy Tester|
//+------------------------------------------------------------------+
#property copyright "AI Studio"
#property link      ""
#property version   "1.00"

#include <Trade\Trade.mqh>

//--- input parameters
input double   InpAtrCoef = 4.0;       // ATR Coefficient (Sensitivity)
input int      InpAtrLen = 10;         // ATR Period
input double   InpLotSize = 0.1;       // Fixed Lot Size for Backtest
input int      InpEmaLen = 200;        // Baseline EMA Period
input bool     InpUseEmaFilter = true; // Use EMA Baseline Filter

//--- global variables
CTrade         trade;
int            atrHandle;
int            emaHandle;
double         c1 = 0.0;
double         c1_prev = 0.0;
bool           isFirstBar = true;

//+------------------------------------------------------------------+
//| Expert initialization function                                   |
//+------------------------------------------------------------------+
int OnInit()
  {
   // Initialize ATR indicator
   atrHandle = iATR(_Symbol, _Period, InpAtrLen);
   if(atrHandle == INVALID_HANDLE)
     {
      Print("Failed to create ATR indicator handle");
      return(INIT_FAILED);
     }
     
   // Initialize EMA indicator
   emaHandle = iMA(_Symbol, _Period, InpEmaLen, 0, MODE_EMA, PRICE_CLOSE);
   if(emaHandle == INVALID_HANDLE)
     {
      Print("Failed to create EMA indicator handle");
      return(INIT_FAILED);
     }
     
   // Set magic number to identify trades
   trade.SetExpertMagicNumber(123456);
   
   return(INIT_SUCCEEDED);
  }

//+------------------------------------------------------------------+
//| Expert deinitialization function                                 |
//+------------------------------------------------------------------+
void OnDeinit(const int reason)
  {
   IndicatorRelease(atrHandle);
   IndicatorRelease(emaHandle);
  }

//+------------------------------------------------------------------+
//| Expert tick function                                             |
//+------------------------------------------------------------------+
void OnTick()
  {
   // We only want to execute our logic once per bar (on the close of the bar)
   // This mimics TradingView's "Once Per Bar Close" alert behavior
   static datetime prevTime = 0;
   datetime currTime = iTime(_Symbol, _Period, 0);
   if(currTime == prevTime) return; // Still on the same bar
   prevTime = currTime;

   // Ensure we have enough bars on chart
   if(iBars(_Symbol, _Period) <= MathMax(InpAtrLen, InpEmaLen) + 2) return;

   // Arrays for data
   double atr[];
   double ema[];
   double close[];
   
   ArraySetAsSeries(atr, true);
   ArraySetAsSeries(ema, true);
   ArraySetAsSeries(close, true);
   
   // Copy the last 1 completed bar for ATR and EMA
   if(CopyBuffer(atrHandle, 0, 1, 1, atr) <= 0) return;
   if(CopyBuffer(emaHandle, 0, 1, 1, ema) <= 0) return;
   
   // Copy the last 2 completed bars for Close (index 1 is latest closed, index 2 is previous closed)
   if(CopyClose(_Symbol, _Period, 1, 2, close) <= 0) return;
   
   double currentClose = close[0]; // Equivalent to 'close' in PineScript on bar close
   double prevClose    = close[1]; // Equivalent to 'close[1]' in PineScript
   double currentAtr   = atr[0];
   double currentEma   = ema[0];
   double loss         = currentAtr * InpAtrCoef;
   
   // Initial condition
   if(isFirstBar)
     {
      c1 = currentClose;
      isFirstBar = false;
      return;
     }
     
   // Store previous C1
   c1_prev = c1;
   
   // PineScript logic translation:
   double t1 = (currentClose > c1_prev) ? (currentClose - loss) : (currentClose + loss);
   
   double t2 = t1;
   if(currentClose < c1_prev && prevClose < c1_prev)
     {
      t2 = MathMin(c1_prev, currentClose + loss);
     }
     
   c1 = t2;
   if(currentClose > c1_prev && prevClose > c1_prev)
     {
      c1 = MathMax(c1_prev, currentClose - loss);
     }
     
   // Signal Conditions
   bool bullSignal = (currentClose > c1 && prevClose <= c1_prev);
   bool bearSignal = (currentClose < c1 && prevClose >= c1_prev);
   
   // Apply EMA Filter
   if(InpUseEmaFilter)
     {
      if(currentClose <= currentEma) bullSignal = false;
      if(currentClose >= currentEma) bearSignal = false;
     }
     
   // Prevent consecutive same-direction signals
   static int currentPos = 0; // 1 for Buy, -1 for Sell
   bool validBullSignal = bullSignal && (currentPos != 1);
   bool validBearSignal = bearSignal && (currentPos != -1);
   
   if(validBullSignal) currentPos = 1;
   if(validBearSignal) currentPos = -1;
   
   // Execute Trades based on Signals
   if(validBullSignal)
     {
      ClosePositions(POSITION_TYPE_SELL);
      if(PositionsTotal() == 0)
        {
         trade.Buy(InpLotSize, _Symbol);
        }
     }
     
   if(validBearSignal)
     {
      ClosePositions(POSITION_TYPE_BUY);
      if(PositionsTotal() == 0)
        {
         trade.Sell(InpLotSize, _Symbol);
        }
     }
  }

//+------------------------------------------------------------------+
//| Helper to close positions by type                                |
//+------------------------------------------------------------------+
void ClosePositions(ENUM_POSITION_TYPE posType)
  {
   for(int i = PositionsTotal() - 1; i >= 0; i--)
     {
      ulong ticket = PositionGetTicket(i);
      if(PositionGetString(POSITION_SYMBOL) == _Symbol)
        {
         if(PositionGetInteger(POSITION_TYPE) == posType)
           {
            trade.PositionClose(ticket);
           }
        }
     }
  }
//+------------------------------------------------------------------+
